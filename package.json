{
  "name": "physics-playground",
  "private": true,
  "type": "module",
  "description": "Fizika maydonçasi: interactive physics simulations with lessons, in Uzbek.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vitepress dev docs --host 127.0.0.1",
    "build": "vitepress build docs",
    "preview": "vitepress preview docs --host 127.0.0.1",
    "predev": "node scripts/build-fonts.mjs && node scripts/build-photos.mjs",
    "prebuild": "node scripts/build-fonts.mjs && node scripts/build-photos.mjs",
    "fonts": "node scripts/build-fonts.mjs --force",
    "photos": "node scripts/build-photos.mjs",
    "budget": "node scripts/check-budget.mjs"
  },
  "devDependencies": {
    "@fontsource/barlow": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "markdown-it-mathjax3": "^4.3.2",
    "sharp": "0.35.5",
    "subset-font": "^2.9.0",
    "vitepress": "1.6.4",
    "vue": "^3.5.46"
  },
  "dependencies": {
    "mathjs": "^15.3.0"
  },
  "overrides": {
    "vite": "^6.4.3"
  }
}
